UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Existing variables
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match Spotify Dashboard Redirect URI exactly (prod example):
# https://komolk.in/api/spotify/callback
SPOTIFY_REDIRECT_URI=
SPOTIFY_REFRESH_TOKEN=

# GitHub — current-month commit count
# Classic PAT: enable the `repo` scope (needed for private repos like portfolio-site)
# Fine-grained: Repository access → All / portfolio-site, Permissions → Contents: Read
GITHUB_TOKEN=
GITHUB_USERNAME=komolkin
# Optional comma-separated repos always counted (private sites often needed here)
GITHUB_COMMIT_REPOS=komolkin/portfolio-site

# fal.ai — AI Cam stadium selfie transform (https://fal.ai/dashboard/keys)
FAL_KEY=
# Optional override, e.g. fal-ai/reve/fast/remix or fal-ai/nano-banana-2/edit
AI_CAM_MODEL=
